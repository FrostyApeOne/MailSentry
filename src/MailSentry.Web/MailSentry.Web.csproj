<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MailSentry</RootNamespace>
    <AssemblyName>MailSentry</AssemblyName>
    <BaseOutputPath>../../bin/</BaseOutputPath>
    <!-- Retain the legacy development output location so an SDK upgrade does not
         orphan existing relative data, signatures or authentication state.
         The directory name is historical; the application runs on .NET 10. -->
    <OutputPath>../../bin/$(Configuration)/net8.0/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../MailSentry.Core/MailSentry.Core.csproj" />
    <ProjectReference Include="../MailSentry.MicrosoftGraph/MailSentry.MicrosoftGraph.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="data/**;auth-record*" />
    <None Remove="data/**;auth-record*" />
    <Content Include="../../appsettings.json" Link="appsettings.json" Condition="Exists('../../appsettings.json')"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
    <Content Include="../../appsettings.example.json" Link="appsettings.example.json"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../signatures/*.json" Link="signatures/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="wwwroot/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
