{
  "version": 1,
  "signatures": [
    {
      "id": "generated-domain",
      "name": "Generated campaign-style domain",
      "score": 4,
      "when": {
        "any": [
          {
            "field": "senderDomain",
            "operator": "startsWith",
            "value": "--"
          },
          {
            "field": "senderDomain",
            "operator": "contains",
            "value": "-----mail."
          }
        ]
      }
    },
    {
      "id": "random-local",
      "name": "Random-looking sender local part",
      "score": 2,
      "when": {
        "field": "senderAddress",
        "operator": "regex",
        "value": "^(?=[^@]*[0-9])[a-z0-9]{7,16}@(?![-][-])"
      }
    }
  ]
}